; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Foxhole Companion App"
run/main_scene="uid://stpx25x0fgbq"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="uid://s4echc32sssw"

[autoload]

SignalBus="*uid://cq6ajwhaw0vuj"
Globals="*uid://u1iuuc0xyq3m"
DataMaster="*uid://bk4il0mp30gq3"
UI="*uid://bhc372vnj5jv4"
DamageCalcWrapper="*uid://cwb1sy67h7a03"

[display]

window/size/viewport_width=420
window/size/viewport_height=800
window/size/borderless=true
window/size/always_on_top=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[file_customization]

folder_colors={
"res://assets/": "red",
"res://scenes/": "orange",
"res://scripts/data_templates/": "purple"
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
viewport/transparent_background=true
